{
  "name": "kalkulator-bazis",
  "version": "2.1.0",
  "private": true,
  "description": "A Kalkulátor Bázis statikus webhelyének minőségellenőrzése.",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "node scripts/local-static-server.js",
    "lint:html": "html-validate '**/*.html'",
    "lint:js": "node scripts/check-js-syntax.js",
    "test:math": "node scripts/math-audit.js",
    "test:invariants": "node scripts/property-invariants-audit.js",
    "test:calculator-suite": "node scripts/calculator-suite-audit.js",
    "test:reference:coverage": "node scripts/reference-coverage-audit.js",
    "test:reference:browser": "node scripts/reference-browser-audit.js",
    "test:browser:all-calculators": "node scripts/all-calculator-browser-smoke.js",
    "test:rules:2026": "node scripts/critical-2026-rules-audit.js",
    "test:periodic": "node scripts/periodic-settlement-audit.js",
    "test:finance:priority": "node scripts/priority-finance-math-audit.js",
    "test:finance:models": "node scripts/finance-model-audit.js",
    "test:construction:priority": "node scripts/priority-construction-math-audit.js",
    "test:health:models": "node scripts/health-model-audit.js",
    "test:brick:data": "node scripts/brick-product-data-audit.js",
    "test:browser:ui": "node scripts/browser-qa.js",
    "test:currency": "node scripts/currency-converter-audit.js",
    "test:expansion:01": "node scripts/expansion-batch-01-audit.js",
    "test:math:update": "node scripts/math-audit.js --write",
    "test:retention": "node scripts/retention-audit.js --summary",
    "sitemap": "node scripts/generate-sitemap.js",
    "taxonomy:apply": "node scripts/apply-category-taxonomy.js",
    "taxonomy:check": "node scripts/category-taxonomy-audit.js",
    "seo:apply": "node scripts/apply-seo-overrides.js",
    "quality:seo": "node scripts/apply-seo-overrides.js --check",
    "feature:periodic:apply": "node scripts/apply-periodic-settlement-upgrade.js",
    "quality:periodic": "node scripts/apply-periodic-settlement-upgrade.js --check",
    "health:apply": "node scripts/apply-health-model-upgrades.js",
    "quality:health": "node scripts/apply-health-model-upgrades.js --check",
    "legacy-generator:quarantine": "node scripts/quarantine-legacy-category-generator.js",
    "quality:legacy-generator": "node scripts/quarantine-legacy-category-generator.js --check",
    "a11y:normalize": "node scripts/normalize-a11y-html.js",
    "quality:a11y-normalize": "node scripts/normalize-a11y-html.js --check",
    "static:materialize": "node scripts/materialize-static-first.js",
    "static:normalize": "node scripts/normalize-static-html.js",
    "static:build": "npm run legacy-generator:quarantine && npm run taxonomy:apply && npm run seo:apply && npm run feature:periodic:apply && npm run health:apply && npm run static:materialize && npm run static:normalize && npm run seo:apply && npm run feature:periodic:apply && npm run health:apply && npm run a11y:normalize",
    "static:check": "node scripts/static-first-audit.js",
    "quality:urls": "node scripts/extensionless-url-audit.js",
    "quality:schema": "node scripts/structured-data-audit.js",
    "quality:adsense-hubs": "node scripts/adsense-quality-audit.js --gate-life-hubs",
    "quality:3": "node scripts/quality-3-audit.js",
    "quality:theme": "node scripts/theme-regression-audit.js",
    "quality": "npm run lint:html && npm run lint:js && npm run quality:urls && npm run taxonomy:check && npm run quality:schema && npm run quality:adsense-hubs && npm run test:reference:coverage && npm run test:rules:2026 && npm run test:periodic && npm run test:finance:priority && npm run test:finance:models && npm run test:construction:priority && npm run test:health:models && npm run test:brick:data && npm run quality:seo && npm run quality:periodic && npm run quality:health && npm run quality:legacy-generator && npm run quality:a11y-normalize && npm run test:math && npm run test:invariants && npm run test:calculator-suite && npm run test:currency && npm run test:expansion:01 && npm run test:expansion:02 && npm run test:expansion:03 && npm run test:expansion:04 && npm run test:expansion:05 && npm run test:retention && npm run quality:3 && npm run quality:theme",
    "test:expansion:02": "node scripts/expansion-batch-02-audit.js",
    "test:expansion:03": "node scripts/expansion-batch-03-audit.js",
    "test:expansion:04": "node scripts/expansion-batch-04-audit.js",
    "test:expansion:05": "node scripts/expansion-batch-05-audit.js"
  },
  "devDependencies": {
    "html-validate": "11.6.2"
  }
}
