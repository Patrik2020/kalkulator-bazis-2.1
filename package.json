{
  "name": "kalkulator-bazis",
  "version": "2.1.0",
  "private": true,
  "description": "A Kalkulátor Bázis statikus webhelyének minőségellenőrzése.",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "node scripts/local-static-server.js",
    "lint:html": "html-validate '**/*.html'",
    "lint:js": "node scripts/check-js-syntax.js",
    "test:math": "node scripts/math-audit.js",
    "test:currency": "node scripts/currency-converter-audit.js",
    "test:expansion:01": "node scripts/expansion-batch-01-audit.js",
    "test:math:update": "node scripts/math-audit.js --write",
    "test:retention": "node scripts/retention-audit.js --summary",
    "sitemap": "node scripts/generate-sitemap.js",
    "taxonomy:apply": "node scripts/apply-category-taxonomy.js",
    "taxonomy:check": "node scripts/category-taxonomy-audit.js",
    "static:materialize": "node scripts/materialize-static-first.js",
    "static:normalize": "node scripts/normalize-static-html.js",
    "static:build": "npm run taxonomy:apply && npm run static:materialize && npm run static:normalize",
    "static:check": "node scripts/static-first-audit.js",
    "quality:3": "node scripts/quality-3-audit.js",
    "quality:theme": "node scripts/theme-regression-audit.js",
    "quality": "npm run lint:html && npm run lint:js && npm run taxonomy:check && npm run test:math && npm run test:currency && npm run test:expansion:01 && npm run test:expansion:02 && npm run test:expansion:03 && npm run test:expansion:04 && npm run test:retention && npm run quality:3 && npm run quality:theme",
    "test:expansion:02": "node scripts/expansion-batch-02-audit.js",
    "test:expansion:03": "node scripts/expansion-batch-03-audit.js",
    "test:expansion:04": "node scripts/expansion-batch-04-audit.js"
  },
  "devDependencies": {
    "html-validate": "11.6.2"
  }
}
